{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://vojtech-blaha01--hulmanek-web.us-east.modal.run/api/:path*" },
    { "source": "/media/:path*", "destination": "https://vojtech-blaha01--hulmanek-web.us-east.modal.run/media/:path*" }
  ],
  "headers": [
    { "source": "/(api|media)/(.*)", "headers": [{ "key": "x-vercel-enable-rewrite-caching", "value": "0" }] },
    { "source": "/(index.html|sw.js|)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
